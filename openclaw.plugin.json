{
  "id": "openclaw-glance-plugin",
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "baseWsUrl": {
        "type": "string"
      },
      "token": {
        "type": "string"
      },
      "lockDir": {
        "type": "string"
      },
      "contactsStorePath": {
        "type": "string",
        "description": "Path to watch-notify-contacts.json (sender defaults for sms/dingtalk/email/call)"
      }
    },
    "required": ["token"]
  }
}
